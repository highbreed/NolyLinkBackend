# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_USER=oscu
POSTGRES_PASSWORD=oscu
POSTGRES_DB=oscu_gateway
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://oscu:oscu@db:5432/oscu_gateway
# Tests always run against this DB, never DATABASE_URL, so create_all/drop_all in the test
# fixtures can't touch real data. Defaults to DATABASE_URL's database name + "_test" if unset.
# The DB role needs CREATEDB, or you create it once yourself:
#   CREATE DATABASE oscu_gateway_test OWNER oscu;
# TEST_DATABASE_URL=postgresql+asyncpg://oscu:oscu@db:5432/oscu_gateway_test

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- KRA eTIMS OSCU / VSCU ---
# NOTE: VSCU is NOT the same protocol as OSCU with just a different host (corrected 2026-09-01
# after decompiling KRA's vscu-v2.0.21.jar — see docs/kra_specs/README.md); a real VSCU device
# is a separate local app on the client's own network, reached via VscuDeviceState.base_url
# (falls back to VSCU_BASE_URL below). KRA_BASE_URL_VSCU_PROD/SBX are effectively dead config
# (2026-09-02 follow-up fix, docs/kra_specs/README.md): there is no KRA-hosted registration
# call for VSCU at all — device_type="VSCU" registers the Branch row locally with no KRA call
# (app/services/cmc_key_manager.py's _register_vscu_branch_locally). Kept only in case a
# genuinely VSCU-relevant KRA-hosted call is ever confirmed to exist.
KRA_ENV=sandbox
KRA_BASE_URL_PROD=https://etims-api.kra.go.ke/etims-api/
KRA_BASE_URL_SBX=https://etims-api-sbx.kra.go.ke/etims-api/
KRA_BASE_URL_VSCU_PROD=
KRA_BASE_URL_VSCU_SBX=
# The receipt-verification URL printed/QR-coded on every receipt (app/services/kra_receipt.py)
# — a different host from KRA_BASE_URL_* above (that's the API host the gateway calls; this is
# the public page a customer's phone scans). Selected by KRA_ENV, same as KRA_BASE_URL.
KRA_RECEIPT_VERIFICATION_BASE_URL_PROD=https://etims.kra.go.ke/common/link/etims/receipt/indexEtimsReceiptData
KRA_RECEIPT_VERIFICATION_BASE_URL_SBX=https://etims-sbx.kra.go.ke/common/link/etims/receipt/indexEtimsReceiptData
KRA_REQUEST_TIMEOUT_SECONDS=30

# --- VSCU integration layer (app/integrations/vscu/) ---
VSCU_ENABLED=false
# Fallback default only — the real per-branch address always lives on VscuDeviceState.base_url
# (each client's VSCU device runs on their own network; there is no one shared "VSCU host").
VSCU_BASE_URL=http://127.0.0.1:8088
VSCU_CONNECT_TIMEOUT_SECONDS=10
VSCU_READ_TIMEOUT_SECONDS=60
# dvcSrlNo for /initializer/selectInitInfo: KRA issues ONE domain-wide serial number to this
# integration (not per-branch, not per-customer) — set it here once you have it, per
# environment. Overridable per-device via VSCUInitializeRequest.dvc_srl_no if a customer's
# device was already initialized under a different value. See Settings.vscu_dvc_srl_no_for_env.
VSCU_DVC_SRL_NO_SBX=
VSCU_DVC_SRL_NO_PROD=

# --- Secrets / encryption ---
# Dev-only Fernet key for cmcKey column encryption. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production backend (Vault vs AWS Secrets Manager) is an open decision - see docs/README.md.
CMC_KEY_ENCRYPTION_KEY=changeme-generate-a-real-fernet-key

# --- Inbound client auth (spec §15) ---
# OAuth2 client-credentials grant (POST /oauth/token) signs JWT access tokens with this key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Per-client rate limit, a fixed-window counter in Redis (spec §15). Not specified by the
# spec — pick a number that fits your expected traffic.
CLIENT_RATE_LIMIT_PER_MINUTE=120

# How many days of raw (redacted) request/response bodies to keep in client_call_log before
# app/workers/cleanup.py deletes them. Not KRA-specified — this is this gateway's own
# operational-debugging retention window.
CLIENT_CALL_LOG_RETENTION_DAYS=30

# Provisional admin gate for POST /v1/devices/initialize and /v1/billing/* — unaffected by
# the OAuth2 system above, since these must never be reachable by SAP/ERP clients at all
# (spec §12.2's reasoning for device init applies equally to billing).
# Send as the X-Admin-Api-Key header. Unset = endpoint refuses everything.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=changeme-generate-a-real-secret

# --- Admin portal login (app/services/admin_user_auth.py) ---
# Sits alongside ADMIN_API_KEY above, not in place of it — either credential grants the same
# admin access. First AdminUser is created using the static key (POST /admin/users); after
# that, ops staff log in via POST /admin/login instead of handling the raw key.
ADMIN_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Client billing / subscription enforcement (this gateway's own tenant billing, entirely
# outside the KRA spec — not part of the eTIMS integration itself) ---
# Defaults OFF. Turning this on before every existing Customer has a Subscription row (via
# PUT /v1/billing/subscriptions/{customer_id}) locks all of them out immediately — no
# subscription on file is treated as unpaid. See app/services/billing_service.py.
BILLING_ENFORCEMENT_ENABLED=false
# Days a customer keeps working past its subscription's paid-through date before being
# blocked. Overridable per-customer via the subscription's own grace_period_days.
BILLING_GRACE_PERIOD_DAYS=7
