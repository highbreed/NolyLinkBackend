[Unit]
Description=KRA VSCU/OSCU Gateway - API (Gunicorn + UvicornWorker)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/home/dev/web_files/kra_vscu/production/kra_vscu_backend
Environment="PATH=/home/dev/web_files/kra_vscu/production/kra_vscu_backend/venv/bin:/usr/bin"
EnvironmentFile=/home/dev/web_files/kra_vscu/production/kra_vscu_backend/.env
StandardOutput=append:/home/dev/web_files/kra_vscu/production/kra_vscu_backend/logs/api.log
StandardError=append:/home/dev/web_files/kra_vscu/production/kra_vscu_backend/logs/api.log
ExecStartPre=/bin/mkdir -p /var/sockets
ExecStartPre=/bin/chown dev:dev /var/sockets
# Migrations run on every start/restart, same as notification-service's unit — alembic is
# idempotent (no-ops once at head), so this is safe whether or not a new migration shipped.
ExecStartPre=/home/dev/web_files/kra_vscu/production/kra_vscu_backend/venv/bin/alembic upgrade head
ExecStart=/home/dev/web_files/kra_vscu/production/kra_vscu_backend/venv/bin/python -m gunicorn \
  app.main:app \
  --worker-class uvicorn.workers.UvicornWorker \
  --workers 4 \
  --bind unix:/var/sockets/kra_vscu_backend_api.sock \
  --access-logfile - \
  --error-logfile -

Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
